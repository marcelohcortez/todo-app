# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGODB_DB=todo

# Long random string used to sign login cookies (32+ chars).
# Generate one with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string

# Public URL of the FRONTEND project (what users and claude.ai open).
# Used for the OAuth discovery documents. No trailing slash.
PUBLIC_URL=https://YOUR-FRONTEND.vercel.app

# Extra hosts that OAuth apps may send the approval code to, comma-separated.
# claude.ai and claude.com are always allowed. Example: chatgpt.com,example.ai
ALLOWED_REDIRECT_HOSTS=

# Set to "true" to allow creating accounts via the login page.
# Turn it back to "false" after you have created your account.
ALLOW_SIGNUP=true

# Pusher Channels, used to tell open devices when a task or note changes.
# Find these in the Pusher dashboard: your app → App Keys.
# Keep PUSHER_SECRET private. Do not commit a filled-in copy of this file.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
